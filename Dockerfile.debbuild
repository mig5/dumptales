# syntax=docker/dockerfile:1
ARG BASE_IMAGE=debian:bookworm
FROM ${BASE_IMAGE}
ENV DEBIAN_FRONTEND=noninteractive
RUN set -eux; . /etc/os-release; if [ "${ID:-}" = ubuntu ]; then \
    apt-get update; apt-get install -y --no-install-recommends software-properties-common ca-certificates; \
    add-apt-repository -y universe; fi
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential debhelper dh-python pybuild-plugin-pyproject python3-all python3-dev \
    python3-poetry-core python3-setuptools python3-wheel python3-pytest rsync devscripts \
    && rm -rf /var/lib/apt/lists/*
RUN cat > /usr/local/bin/build-deb <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
root=$(mktemp -d)
trap 'rm -rf "$root"' EXIT
version=$(python3 - <<'PY'
import tomllib
with open('/src/pyproject.toml', 'rb') as stream:
    print(tomllib.load(stream)['project']['version'])
PY
)
mkdir -p "$root/dumptales-$version" /out
rsync -a --exclude .git --exclude .venv --exclude dist --exclude build \
  --exclude '*.egg-info' --exclude __pycache__ --exclude /setup.py \
  --exclude /PKG-INFO --exclude /MANIFEST.in --exclude '_dumptales_native*.so' \
  --exclude '_dumptales_native*.pyd' /src/ "$root/dumptales-$version/"
cd "$root/dumptales-$version"
if [ -n "${SUITE:-}" ]; then
  DEBEMAIL='mig@mig5.net' DEBFULLNAME='Miguel Jacq' \
    dch --distribution "$SUITE" --local "~$SUITE" "Build for $SUITE"
fi
# The upstream tarball excludes Debian packaging as required by 3.0 (quilt).
tar -C "$root" --exclude="dumptales-$version/debian" -czf "$root/dumptales_$version.orig.tar.gz" "dumptales-$version"
dpkg-buildpackage -us -uc -b
shopt -s nullglob
cp "$root"/*.deb "$root"/*.changes "$root"/*.buildinfo /out/
packages=(/out/dumptales_*.deb)
if [ "${#packages[@]}" -ne 1 ]; then
  echo "Expected one main dumptales .deb in /out, found ${#packages[@]}" >&2
  exit 1
fi
for package in "${packages[@]}"; do
  contents="$(dpkg-deb -c "$package")"
  if ! grep -Eq '_dumptales_native.*\.so' <<< "$contents"; then
    echo "Native extension missing from $package; package contents:" >&2
    printf '%s\n' "$contents" >&2
    exit 1
  fi
done
EOF
RUN chmod +x /usr/local/bin/build-deb
ENTRYPOINT ["/usr/local/bin/build-deb"]
